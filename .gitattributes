# Text normalization: store LF, checkout LF for the skill's own files.
* text=auto eol=lf

# Checked out with CRLF so Windows editors and PowerShell are happy.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary artifacts must never be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
